{
  "name": "@yrda/beygir",
  "version": "0.2.0-next.4",
  "description": "Uppflettingasafn í íslenskum beygingum og BÍN-gögnum fyrir Bun og Node.js.",
  "license": "Apache-2.0 AND CC-BY-SA-4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yrda-is/beygir.git"
  },
  "bugs": {
    "url": "https://github.com/Yrda-is/beygir/issues"
  },
  "homepage": "https://github.com/Yrda-is/beygir#readme",
  "keywords": [
    "icelandic",
    "icelandic-inflection",
    "icelandic-language",
    "inflection",
    "inflectional-morphology",
    "morphology",
    "word-forms",
    "bin-icelandic",
    "beygingar",
    "beygingarmyndir"
  ],
  "files": [
    "kóði/",
    "!kóði/**/*.test.ts",
    "!kóði/kristínarsnið/",
    "!kóði/snið/dafsa-röðun.ts",
    "!kóði/snið/dafsa-smíði.ts",
    "!kóði/snið/skráarsnið/",
    "!kóði/snið/smiður/",
    "!kóði/snið/smíði.ts",
    "dreifing/",
    "!dreifing/kóði/kristínarsnið/",
    "!dreifing/kóði/snið/dafsa-röðun.d.ts",
    "!dreifing/kóði/snið/dafsa-smíði.d.ts",
    "!dreifing/kóði/snið/skráarsnið/",
    "!dreifing/kóði/snið/smiður/",
    "!dreifing/kóði/snið/smíði.d.ts",
    ".gögn/beygir.bin.br",
    ".gögn/beygir.bin.sha256",
    "README.md",
    "LICENSE",
    "NOTICE",
    "GÖGN-OG-LEYFI.md"
  ],
  "exports": {
    ".": {
      "types": "./dreifing/kóði/beygir/beygir.d.ts",
      "bun": "./kóði/beygir/beygir.ts",
      "default": "./dreifing/kóði/beygir/beygir.js"
    },
    "./gagnaskrá": {
      "types": "./dreifing/kóði/beygir/gagnaskrá.d.ts",
      "bun": "./kóði/beygir/gagnaskrá.ts",
      "default": "./dreifing/kóði/beygir/gagnaskrá.js"
    },
    "./vefur": {
      "types": "./dreifing/kóði/beygir/vefur.d.ts",
      "browser": "./dreifing/kóði/beygir/vefur.js",
      "default": "./dreifing/kóði/beygir/vefur.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "prepack": "bun run ./skriftur/undirbúa-pökkun.ts",
    "gefa:út": "bun run ./skriftur/gefa-út.ts",
    "próf": "bun test",
    "node:reykpróf": "node próf/node-reykpróf.mjs",
    "skjöl": "bunx --bun typedoc --options typedoc/typedoc.json",
    "smíða:dreifingu": "bun run ./skriftur/smíða-dreifingu.ts",
    "smíða:gagnaskrá": "bun run ./skriftur/smíða-gagnaskrá.ts",
    "smíða:skráarsnið": "bun run ./skriftur/smíða-skráarsnið.ts",
    "smíða:skráarsnið:athuga": "bun run ./skriftur/smíða-skráarsnið.ts --athuga",
    "viðmið": "bun run ./skriftur/viðmið.ts",
    "sækja:gögn": "bun run ./skriftur/sækja-kristínarsnið.ts .gögn",
    "test": "bun test",
    "tsc": "bunx --bun tsc --noEmit",
    "eslint": "bunx --bun eslint .",
    "prettier:athuga": "bunx --bun prettier --check .",
    "prettier:laga": "bunx --bun prettier --write .",
    "dauður-kóði": "bunx --bun knip",
    "kemba": "bun run smíða:skráarsnið && bun run prettier:laga && bun run eslint && bun run tsc && bun run dauður-kóði && bun run smíða:dreifingu && bun test",
    "kemba:skoða": "bun run smíða:skráarsnið:athuga && bun run prettier:athuga && bun run eslint && bun run tsc && bun run dauður-kóði && bun run smíða:dreifingu && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "knip": "6.3.0",
    "mitata": "^1.0.34",
    "prettier": "3.8.1",
    "typedoc": "0.28.19",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0",
    "zod": "4.3.6"
  }
}
